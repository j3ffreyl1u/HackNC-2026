# All providers default to local/mock modes. Do not put real keys in this file.
# CHAT_MODE: mock | photon. RESEARCH_MODE: mock | gemini | live. VOICE: off | gemini (rewords replies so they read like a friend texting).
CHAT_MODE=mock
RESEARCH_MODE=mock
VOICE=off
CALENDAR_MODE=manual
FUNDING_MODE=disabled

TRIP_CONFIG_PATH=tests/fixtures/trip.json
DATABASE_PATH=data/trips.sqlite
PORT=3000
# Address phones can open for the trip page and calendar link in texts. localhost does NOT work on a phone: use a tunnel's https address
# (e.g. run `cloudflared tunnel --url http://127.0.0.1:3000`, then paste the https://...trycloudflare.com address here, no trailing slash).
PUBLIC_BASE_URL=

# Spectrum Cloud credentials (required only for CHAT_MODE=photon).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Gemini key required for Photon language parsing and live research display.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash.
GEMINI_MODEL=
GEMINI_INTENT_MODEL=
GEMINI_VOICE_MODEL=
# Optional adapters below remain disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
# JSON file mapping each trip member ID to that friend's own sandbox account ID (the simulator writes data/simulated-accounts.json). No real money.
NESSIE_ACCOUNTS_PATH=
# Ignored JSON file mapping simulator-created merchant IDs to their category strings.
NESSIE_MERCHANTS_PATH=
# Demo only (FUNDING_MODE=nessie): LOG_PURCHASES=on lets someone text "I just paid $60 for gas" after approval, which records a
# purchase in that person's own sandbox account. Off by default.
LOG_PURCHASES=
# Optional: real hotel prices for live research (Google Hotels through serpapi.com). Each priced option uses one search.
SERPAPI_API_KEY=
# Searches one run may spend (default 30); identical searches are reused for 12 hours. Your plan has a monthly limit, so keep this low.
SERPAPI_MAX_SEARCHES=

# Where messages the assistant could not understand are logged for review (default data/misses.jsonl).
MISS_LOG_PATH=
